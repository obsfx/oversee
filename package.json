    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-relative-import-paths": "1.7.3",
