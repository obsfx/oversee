    "eslint-plugin-storybook": "10.6.1",
    "globals": "^17.12.0",
    "google-font-metadata": "6.0.8",
    "playwright": "^1.64.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "10.6.1",
    "typescript": "~6.0.2",
