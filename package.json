{
  "name": "oversee",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "go run ./cmd/oversee -C ${OVERSEE_DEV_REPO:-/Users/omercanbalandi/oaks-lab/storyvine/now-api} serve --dev --port 4400",
    "build": "tsc -b && vite build",
    "build:ui": "tsc -b && vite build --mode embed",
    "build:cli": "pnpm build:ui && go build -o bin/oversee ./cmd/oversee",
    "build:npm": "pnpm build:ui && node scripts/build-npm.mjs",
    "generate:sql": "go tool sqlc generate -f internal/storage/sqlite/sqlc.yaml",
    "generate:gdscript": "node scripts/generate-gdscript-grammar.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "preview": "vite preview",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@pierre/diffs": "1.5.2",
    "@tailwindcss/vite": "4.3.3",
