    "@tiptap/extensions": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/static-renderer": "3.31.4",
    "@uidotdev/usehooks": "2.4.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "plur": "6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "5.7.0",
    "react-resizable-panels": "4.14.4",
    "tailwindcss": "4.3.3",
    "valibot": "1.5.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
